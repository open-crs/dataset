FROM --platform=linux/amd64 ubuntu:24.04

ENV USER="docker" \
    HOME="/home/docker" \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        gcc-multilib \
        g++-multilib \
        libc6-dev-i386 \
    && rm -rf /var/lib/apt/lists/*

CMD ["/bin/bash"]