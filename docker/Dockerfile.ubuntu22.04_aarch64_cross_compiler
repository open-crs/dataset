FROM --platform=linux/amd64 ubuntu:22.04

ENV USER="docker" \
    HOME="/home/docker" \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gcc-aarch64-linux-gnu \
        g++-aarch64-linux-gnu \
        libc6-dev-arm64-cross \
        make \
    && rm -rf /var/lib/apt/lists/*

CMD ["/bin/bash"]
